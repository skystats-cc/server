NODE_ENV=development
HOST=0.0.0.0
PORT=3000
LOG_LEVEL=info

DATABASE_URL=postgres://skystats:skystats@localhost:5432/skystats

# Long random string; protects /admin/* (used by the MCP server)
ADMIN_API_KEY=change-me-to-a-long-random-string

# HTTP
TRUST_PROXY=true
# Browser origins allowed cross-origin (comma-separated). Not needed when the web app proxies /v1.
CORS_ORIGINS=
RATE_LIMIT_PER_MIN=120

# Hypixel. Bazaar + status work without a key; player/profile data needs one.
HYPIXEL_API_KEY=
HYPIXEL_RATE_LIMIT_PER_5MIN=300

# Ingestion timing
BAZAAR_POLL_SECONDS=30
BAZAAR_SNAPSHOT_CRON=0 */2 * * *
STATUS_POLL_SECONDS=60