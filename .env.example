NODE_ENV=development
HOST=0.0.0.0
PORT=3000
LOG_LEVEL=info

DATABASE_URL=postgres://skystats:skystats@localhost:5432/skystats

# Long random string; protects /admin/* (used by the MCP server)
ADMIN_API_KEY=change-me-to-a-long-random-string

# HTTP
TRUST_PROXY=true
# Browser origins allowed cross-origin (comma-separated). Not needed when the web app proxies /v1.
CORS_ORIGINS=
RATE_LIMIT_PER_MIN=120

# Hypixel. Bazaar + status work without a key; SkyBlock profiles/co-ops need one
# (get a production key from https://developer.hypixel.net).
HYPIXEL_API_KEY=
HYPIXEL_RATE_LIMIT_PER_5MIN=300

# Ingestion timing
BAZAAR_POLL_SECONDS=30
BAZAAR_SNAPSHOT_CRON=0 */2 * * *
STATUS_POLL_SECONDS=60
# Accounts & sessions
MOJANG_SESSION_URL=https://sessionserver.mojang.com
SESSION_COOKIE_SECURE=auto
WEB_SESSION_DAYS=30
MOD_SESSION_DAYS=90

# SkyBlock profiles
# On-demand lookups only (no polling): Hypixel's API policy forbids building histories by polling.
PROFILE_REFRESH_MIN_MINUTES=60
# Money history comes from the mod; at most one stored snapshot per member per N minutes
MEMBER_SNAPSHOT_MIN_MINUTES=5

# Billing (Stripe). Prices shown to UK consumers must include VAT.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICES_PRO=
STRIPE_PRICES_MAX=
PUBLIC_WEB_URL=https://skystats.cc
BILLING_GRACE_DAYS=7
SOFT_RETENTION_DAYS=30
